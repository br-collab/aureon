# Aureon-Leto — CAOM-001 Operator Console — local environment
# Copy to aureon-leto/.env (gitignored) and fill in real values.

# Kraken — REQUIRED for direct kill-switch fallback and auth health check.
# These are SEPARATE from the Railway env vars. Aureon-Leto needs its own copy.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Railway production base URL (default OK).
RAILWAY_BASE=https://aureon-production.up.railway.app

# GitHub repo for commit health check (default OK).
GITHUB_REPO=br-collab/aureon

# Local server port (default 5002).
CONSOLE_PORT=5002

# Health-monitor poll interval in seconds (default 30).
HEALTH_INTERVAL=30

# Anthropic API — optional. If set, Sam tasks submitted via the
# Command Surface auto-dispatch to the Anthropic API; the response
# appears inline in the UI without manual paste-into-Claude-Code.
# This Sam is stateless per task; for tasks needing real shell/git/
# file access, dispatch via Claude Code chat using the inbox path
# (still surfaced in the UI when no key is set).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
