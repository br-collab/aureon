# Aureon / The Grid 3 — environment scaffold.
#
# Copy this file to `.env` and populate with real values. Production
# values live in Railway service variables, not on disk. Never commit
# a populated `.env` to the repo (it is gitignored).

# --- FRED (St. Louis Fed) ---------------------------------------------------
# Used by server.py (_fred_series_latest) and aureon/mmf/yield_engine.py
# (DGS1MO + SOFR for MMF daily accrual).
# Unauthenticated calls work but with lower rate limits. Get a free
# key at https://fred.stlouisfed.org/docs/api/api_key.html.
FRED_API_KEY=
