# CAOM-001 Operator Console — local environment
# Copy to console/.env (gitignored) and fill in real values.

# Kraken — REQUIRED for direct kill-switch fallback and auth health check.
# These are SEPARATE from the Railway env vars. Local console needs its own copy.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Railway production base URL (default OK).
RAILWAY_BASE=https://aureon-production.up.railway.app

# GitHub repo for commit health check (default OK).
GITHUB_REPO=br-collab/aureon

# Vercel deployment URL — leave blank to skip the Vercel health check.
VERCEL_URL=

# Twelve Data — optional. Only used for tier-3 price-feed freshness.
TWELVE_DATA_API_KEY=

# Local server port (default 5002).
CONSOLE_PORT=5002

# Health-monitor poll interval in seconds (default 30).
HEALTH_INTERVAL=30
